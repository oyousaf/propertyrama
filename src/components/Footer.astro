---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Address from './Address.astro';
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---
<footer data-band class="bg-band text-band-fg">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="grid content-start justify-items-start gap-4">
      <Logo tone="band" />
      <p class="max-w-sm text-band-muted">Independent property maintenance based in Milton Keynes.</p>
      <ul class="-ml-3 flex">
        {site.social.map((s) => (
          <li><a href={s.href} rel="noopener" class="flex size-12 items-center justify-center text-band-fg hover:text-signal" aria-label={`PropertyRama on ${s.label}`}><Icon name={s.icon} size={22} /></a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="font-sans text-sm font-semibold tracking-wider text-band-muted uppercase">Contact</h2>
      <ul class="mt-3 grid gap-1">
        <li><a href={site.phoneHref} class="flex min-h-11 items-center gap-3 text-band-fg no-underline hover:underline"><Icon name="phone" size={20} />{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="flex min-h-11 items-center gap-3 break-all text-band-fg no-underline hover:underline"><Icon name="mail" size={20} />{site.email}</a></li>
        <li><a href={site.mapsHref} rel="noopener" class="flex items-start gap-3 py-2 text-band-fg no-underline hover:underline"><Icon name="pin" size={20} class="mt-1" /><Address /></a></li>
      </ul>
    </div>
    <nav aria-label="Footer">
      <h2 class="font-sans text-sm font-semibold tracking-wider text-band-muted uppercase">Pages</h2>
      <ul class="mt-3 grid">
        {nav.map((n) => (<li><a href={n.href} class="flex min-h-11 items-center text-band-fg no-underline hover:underline">{n.label}</a></li>))}
        <li><a href="/quote" class="flex min-h-11 items-center text-band-fg no-underline hover:underline">Get a free quote</a></li>
        <li><a href="/privacy" class="flex min-h-11 items-center text-band-fg no-underline hover:underline">Privacy</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap text-sm text-band-muted">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-t border-band-muted/30 py-5">
      <p>© {year} {site.legalName}</p>
      <p>Built with <span class="inline-block motion-safe:animate-heartbeat" role="img" aria-label="love">💚</span> by <a href="https://legxcysol.dev" target="_blank" rel="noopener" class="inline-flex min-h-6 items-center text-band-fg underline underline-offset-2 hover:text-signal">Legxcy Solutions<span class="sr-only"> (opens in a new tab)</span></a></p>
    </div>
  </div>
</footer>
