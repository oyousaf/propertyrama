---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, nav } from '../data/site';
const path = Astro.url.pathname.replace(/(\.html|\/)$/, '') || '/';
---
<a href="#main" class="sr-only z-50 bg-signal px-4 py-3 font-bold text-on-signal focus:not-sr-only focus:fixed focus:top-2 focus:left-2">Skip to content</a>
<header class="bg-surface">
  <div class="wrap flex min-h-18 items-center justify-between gap-4">
    <Logo />
    <nav aria-label="Main" class="hidden items-center gap-7 lg:flex">
      {nav.map((n) => (
        <a href={n.href} aria-current={path === n.href ? 'page' : undefined} class="py-3 font-semibold text-fg no-underline decoration-signal decoration-3 underline-offset-8 hover:underline aria-[current=page]:underline">{n.label}</a>
      ))}
      <a href={site.phoneHref} class="flex items-center gap-2 py-3 font-bold text-fg no-underline hover:underline"><Icon name="phone" size={20} />{site.phone}</a>
      <a href="/quote" class="btn btn-signal">Get a free quote</a>
    </nav>
    <button type="button" popovertarget="mobile-menu" class="-mr-2 flex size-12 items-center justify-center lg:hidden" aria-label="Open menu">
      <Icon name="menu" />
    </button>
  </div>
</header>
<div id="mobile-menu" popover class="m-0 ml-auto h-dvh max-h-none w-[min(22rem,100vw)] max-w-none bg-surface p-5 text-fg backdrop:bg-black/50">
  <div class="flex justify-end">
    <button type="button" popovertarget="mobile-menu" popovertargetaction="hide" autofocus class="-mt-1 -mr-2 flex size-12 items-center justify-center" aria-label="Close menu"><Icon name="close" /></button>
  </div>
  <nav aria-label="Mobile" class="mt-2 grid gap-1">
    {nav.map((n) => (
      <a href={n.href} class="py-3 font-display text-2xl font-bold text-fg no-underline">{n.label}</a>
    ))}
    <a href="/quote" class="btn btn-signal mt-4">Get a free quote</a>
    <a href={site.phoneHref} class="btn btn-ghost mt-2"><Icon name="phone" size={20} />{site.phone}</a>
  </nav>
</div>
