---
interface Props {
  headline: string;
  quote: string;
  author: string;
  job: string;
  source?: string;
  level?: 'h2' | 'h3';
}
const { headline, quote, author, job, level: Heading = 'h3' } = Astro.props;
---
<figure class="grid content-start gap-4 border-t-4 border-signal pt-5">
  <Heading class="text-2xl">{headline}</Heading>
  <blockquote><p>{quote}</p></blockquote>
  <figcaption class="text-sm"><strong class="block text-base">{author}</strong>{job}</figcaption>
</figure>
