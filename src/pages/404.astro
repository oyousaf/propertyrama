---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | PropertyRama" description="This page could not be found.">
  <div class="wrap grid justify-items-start gap-5 py-16 lg:py-24">
    <h1 class="text-hero">We can't find that page</h1>
    <p class="text-lg text-muted">It may have moved. Our services and quote form are a click away.</p>
    <div class="flex flex-wrap gap-3">
      <a href="/services" class="btn btn-ghost text-fg">See our services</a>
      <a href="/quote" class="btn btn-signal">Get a free quote</a>
    </div>
  </div>
</Base>
